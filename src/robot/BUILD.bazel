load("@rules_oci//oci:defs.bzl", "oci_image", "oci_tarball")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_library")

# Put all robot files in this library
py_library(
    name = "robot_py",
    srcs = [
        "config.py",
        "robot.py",
        "structs.py",
    ],
    deps = [
        "@pypi//fastapi:pkg",
        "@pypi//jinja2:pkg",
        "@pypi//numpy:pkg",
        "@pypi//opencv_python:pkg",
        "@pypi//websockets:pkg",
    ],
)

cc_library(
    name = "robot_cpp",
    srcs = [
        "robot.cpp",
    ],
    hdrs = [
        "robot.h",
    ],
    deps = [
        "//lib/actuator:dynamixel_motor",
        "//lib/kinematics/old:kinematics_interface_lib",
        "@eigen",
    ],
)

cc_binary(
    name = "main",
    srcs = [
        "main.cpp",
    ],
    deps = [
        "robot_cpp",
        "@eigen",
    ],
)

pkg_tar(
    name = "tar",
    srcs = [":main"],
)

oci_image(
    name = "image",
    base = "@gcc",
    entrypoint = ["src/robot/main"],
    tars = [":tar"],
)

oci_tarball(
    name = "image_tarball",
    image = ":image",
    repo_tags = ["trentonbot_robot:latest"],
)
